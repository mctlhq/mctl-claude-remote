#!/usr/bin/env bash
# Mint a short-lived GitHub App installation token and write it to a file.
#
# Generic, no org-specific values. Signs an RS256 JWT with the App private
# key, exchanges it for an installation access token (valid ~1h), and writes
# the token to the output path with mode 0400.
#
# The token is NEVER printed to stdout/stderr and NEVER placed on a command
# line. Do not enable shell tracing (set -x) in this script.
#
# Env / args:
#   GH_APP_ID                 GitHub App ID (numeric)            [required]
#   GH_APP_INSTALLATION_ID    Installation ID (numeric)          [required]
#   GH_APP_PRIVATE_KEY_FILE   Path to the App private key (PEM)  [required]
#   GH_APP_TOKEN_FILE         Output path for the token          [default: /run/steward/gh-token]
#   GH_HOST                   GitHub host                        [default: github.com]
#   GH_API_BASE               API base URL                       [default: derived from GH_HOST]
set -eu

# Derive the API base from GH_HOST so the minter follows the same host the
# steward authenticates against, instead of always hitting api.github.com.
# GH_API_BASE still wins if set explicitly. GHES exposes the REST API under
# https://<host>/api/v3; GHEC data-residency (*.ghe.com) under https://api.<host>.
if [ -n "${GH_API_BASE:-}" ]; then
  API_BASE="$GH_API_BASE"
else
  case "${GH_HOST:-github.com}" in
    github.com) API_BASE="https://api.github.com" ;;
    *.ghe.com)  API_BASE="https://api.${GH_HOST}" ;;
    *)          API_BASE="https://${GH_HOST}/api/v3" ;;
  esac
fi
APP_ID="${GH_APP_ID:-}"
INSTALLATION_ID="${GH_APP_INSTALLATION_ID:-}"
KEY_FILE="${GH_APP_PRIVATE_KEY_FILE:-}"
OUT_FILE="${GH_APP_TOKEN_FILE:-/run/steward/gh-token}"

die() { echo "gh-app-token: $*" >&2; exit 1; }

[ -n "$APP_ID" ] || die "GH_APP_ID is required"
[ -n "$INSTALLATION_ID" ] || die "GH_APP_INSTALLATION_ID is required"
[ -n "$KEY_FILE" ] || die "GH_APP_PRIVATE_KEY_FILE is required"
[ -r "$KEY_FILE" ] || die "private key not readable: $KEY_FILE"
command -v openssl >/dev/null 2>&1 || die "openssl not found"
command -v jq >/dev/null 2>&1 || die "jq not found"
command -v curl >/dev/null 2>&1 || die "curl not found"

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

now="$(date +%s)"
# exp must be <= 10 min per GitHub; iat backdated 60s for clock skew.
header='{"alg":"RS256","typ":"JWT"}'
payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$APP_ID")"

h_b64="$(printf '%s' "$header" | b64url)"
p_b64="$(printf '%s' "$payload" | b64url)"
signing_input="${h_b64}.${p_b64}"

sig="$(printf '%s' "$signing_input" \
  | openssl dgst -sha256 -sign "$KEY_FILE" \
  | b64url)" || die "JWT signing failed"
jwt="${signing_input}.${sig}"

# Exchange the JWT for an installation token. The request (including the
# Authorization header carrying the JWT) is fed to curl via --config on stdin,
# so the JWT never appears in this process's argv — it cannot be read via `ps`
# or /proc/<pid>/cmdline by other same-user processes. The token in the
# response is captured into a variable and never echoed.
#
# --connect-timeout/--max-time bound the call so a blackholed or half-open
# network path returns to the caller's retry loop instead of hanging forever
# (which would block the refresh loop and let the installation token expire).
resp="$(
  curl -sS --connect-timeout 10 --max-time 30 --config - <<EOF
url = "${API_BASE}/app/installations/${INSTALLATION_ID}/access_tokens"
request = "POST"
header = "Authorization: Bearer ${jwt}"
header = "Accept: application/vnd.github+json"
header = "X-GitHub-Api-Version: 2022-11-28"
EOF
)" || die "installation token request failed"

token="$(printf '%s' "$resp" | jq -r '.token // empty')"
expires="$(printf '%s' "$resp" | jq -r '.expires_at // empty')"

if [ -z "$token" ]; then
  # Surface the error message but never the (absent) token.
  msg="$(printf '%s' "$resp" | jq -r '.message // "unknown error"')"
  die "no token in response: ${msg}"
fi

mkdir -p "$(dirname "$OUT_FILE")"
umask 077
# Write atomically so a concurrent reader never sees a partial token.
tmp="$(mktemp "${OUT_FILE}.XXXXXX")"
printf '%s' "$token" > "$tmp"
chmod 0400 "$tmp"
mv -f "$tmp" "$OUT_FILE"

echo "gh-app-token: wrote installation token to ${OUT_FILE} (expires ${expires:-unknown})"
