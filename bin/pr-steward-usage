#!/usr/bin/env python3
"""Turn one pr-steward tick's model usage into ADR-012 usage records and hand
them to the usage ledger's collector (mctlhq/.github#50).

The steward's paid model calls are the fix-only half of a DevLoop, so its
spend belongs in the same ledger as the investigator, implementer, reviewer
and shepherd stages. This pod is not a place for a ledger writer credential:
the tick runs `claude -p --dangerously-skip-permissions` under the same uid as
everything here, so any token on disk is readable by the model. The records
therefore leave the pod the way the reviewer's do: they become a
`model-usage-records` workflow artifact, which the existing in-cluster usage
collector already sweeps and sanitises. The steward's own GitHub App token
(contents: write) can send a `repository_dispatch` to `mctlhq/.github`, whose
`steward-usage.yml` validates the records and uploads the artifact. No new
secret and no new permission.

What this program deliberately does NOT do (the same rules the reviewer's
capture follows, ADR-012):
  - copy any text: only the result entry's scalar fields and the modelUsage
    counters are read; the tick's prose never enters a record;
  - write 0 for a counter the CLI did not report: absent stays absent;
  - set calculated_cost, pricing_version or provider_reported_cost: the
    ledger prices the token counts from its own versioned catalog at ingest;
  - mint a record id: the ledger derives it from session_id/result_uuid/
    model_key, so a redelivered dispatch adds no row;
  - invent correlation: the steward has no work item and no Temporal run, so
    work_item_id / temporal ids are left absent, never filled.

PR attribution: a tick may act on several PRs, and its usage cannot be split
between them honestly. `target_repo` / `pr_number` are set only when the
steward's structured log, read from this tick's byte window, shows actions on
exactly one PR of a configured repo under exactly one tick_id; otherwise both
are absent. Every doubt fails toward absent: an unknown window start (offset
-1), a window larger than the read cap, several tick_ids or several PRs.

It never fails the tick: usage capture is observability. Every problem is a
warning on stderr and exit status 0. It never prints the token.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from typing import Any

AGENT = "pr-steward"
STAGE = "shepherd"
DISPATCH_REPO = "mctlhq/.github"
EVENT_TYPE = "pr-steward-usage"
MAX_RECORDS = 20
LOG_TAIL_CAP = 1 << 20
DEFAULT_CONFIG = "/workspace/pr-steward.config.json"
REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")


def warn(message: str) -> None:
    print(f"[pr-steward-usage] WARN {message}", file=sys.stderr)


def _count(value: Any) -> int | None:
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        return None
    return value


def _text(value: Any) -> str | None:
    return value if isinstance(value, str) and value != "" else None


def result_entry(raw: str) -> dict[str, Any] | None:
    """The tick's final `result` entry: `--output-format json` prints one
    object; a stream/array form is tolerated by taking the last result."""
    try:
        doc = json.loads(raw)
    except ValueError:
        return None
    entries = doc if isinstance(doc, list) else [doc]
    results = [e for e in entries if isinstance(e, dict) and e.get("type") == "result"]
    return results[-1] if results else None


def acted_pr(log_tail: str | None, repos: set[str]) -> tuple[str, int] | None:
    """The single (repo, pr) the tick's structured log lines name, or None
    when the window is unknown, there are zero or several PRs, the lines carry
    other than exactly one tick_id, or the repo is not a configured one."""
    if log_tail is None:
        return None
    seen: set[tuple[str, int]] = set()
    ticks: set[Any] = set()
    for line in log_tail.splitlines():
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if not isinstance(entry, dict):
            continue
        tick = entry.get("tick_id")
        ticks.add(tick if isinstance(tick, str) and tick else None)
        repo, pr = entry.get("repo"), entry.get("pr")
        if not isinstance(repo, str) or not REPO_RE.match(repo) or repo not in repos:
            continue
        if isinstance(pr, bool) or not isinstance(pr, int) or pr <= 0:
            continue
        seen.add((repo, pr))
    if len(ticks) > 1 or None in ticks:
        if seen:
            warn("tick window holds lines from several or unnamed tick_ids; usage left unattributed")
        return None
    return next(iter(seen)) if len(seen) == 1 else None


def build_records(result: dict[str, Any], target: tuple[str, int] | None,
                  captured_at: str) -> list[dict[str, Any]]:
    session_id = _text(result.get("session_id"))
    usage = result.get("modelUsage")
    if session_id is None or not isinstance(usage, dict):
        return []
    outcome = "success" if result.get("subtype") == "success" and result.get("is_error") is not True else "error"
    api_status = result.get("api_error_status")
    records = []
    for model, counters in usage.items():
        if not isinstance(model, str) or model == "" or not isinstance(counters, dict):
            continue
        record: dict[str, Any] = {
            "schema_version": 1,
            "session_id": session_id,
            "result_uuid": _text(result.get("uuid")),
            "model_key": model,
            "canonical_model": _text(counters.get("canonicalModel")),
            "provider": _text(counters.get("provider")),
            "agent": AGENT,
            "devloop_stage": STAGE,
            "target_repo": target[0] if target else None,
            "pr_number": target[1] if target else None,
            "input_tokens": _count(counters.get("inputTokens")),
            "output_tokens": _count(counters.get("outputTokens")),
            "cache_read_tokens": _count(counters.get("cacheReadInputTokens")),
            "cache_write_tokens": _count(counters.get("cacheCreationInputTokens")),
            "web_search_requests": _count(counters.get("webSearchRequests")),
            "outcome": outcome,
            "api_error_status": str(api_status) if isinstance(api_status, int) and not isinstance(api_status, bool) else _text(api_status),
            "stop_reason": _text(result.get("stop_reason")),
            "terminal_reason": _text(result.get("terminal_reason")),
            "num_turns": _count(result.get("num_turns")),
            "duration_api_ms": _count(result.get("duration_api_ms")),
            # One tick is one fresh `claude -p` session with no retry.
            "retry_attempt": 0,
            "recorded_at": captured_at,
        }
        records.append({k: v for k, v in record.items() if v is not None})
    if len(records) > MAX_RECORDS:
        warn(f"{len(records)} models in one tick; only the first {MAX_RECORDS} are recorded")
    return records[:MAX_RECORDS]


def configured(config_path: str) -> tuple[set[str], str | None]:
    """Configured repo names and the structured log path from the steward config."""
    try:
        with open(config_path, encoding="utf-8") as fh:
            cfg = json.load(fh)
    except (OSError, ValueError) as exc:
        warn(f"cannot read steward config {config_path}: {exc.__class__.__name__}")
        return set(), None
    repos = {r.get("name") for r in cfg.get("repos", []) if isinstance(r, dict) and isinstance(r.get("name"), str)}
    log = cfg.get("logging", {}).get("file") if isinstance(cfg.get("logging"), dict) else None
    return repos, log if isinstance(log, str) else None


def log_tail(path: str | None, offset: int) -> str | None:
    """This tick's log window, or None when it cannot be known whole: no log
    path, a negative (unknown) start, an unreadable file, or more than
    LOG_TAIL_CAP bytes (a partial window could name one PR of several)."""
    if not path:
        return None
    if offset < 0:
        warn("tick log window start unknown; usage left unattributed")
        return None
    try:
        with open(path, "rb") as fh:
            fh.seek(offset)
            data = fh.read(LOG_TAIL_CAP + 1)
    except OSError:
        warn("steward log unreadable; usage left unattributed")
        return None
    if len(data) > LOG_TAIL_CAP:
        warn("tick log window exceeds the read cap; usage left unattributed")
        return None
    return data.decode("utf-8", "replace")


def dispatch(records: list[dict[str, Any]], token_file: str) -> bool:
    try:
        with open(token_file, encoding="utf-8") as fh:
            token = fh.read().strip()
    except OSError:
        warn("no GitHub App token file; usage records not sent")
        return False
    if not token:
        warn("empty GitHub App token file; usage records not sent")
        return False
    body = json.dumps({"event_type": EVENT_TYPE, "client_payload": {"records": records}})
    # The ledger's dispatch target is a github.com repository. A token minted
    # for another host is not sent there, and the dispatch is pinned to
    # github.com rather than following an inherited GH_HOST.
    if os.environ.get("GH_HOST", "github.com") != "github.com":
        warn("GH_HOST is not github.com; the github.com usage dispatch is skipped")
        return False
    env = dict(os.environ, GH_TOKEN=token, GH_HOST="github.com")
    try:
        proc = subprocess.run(  # noqa: S603 - fixed argv, token only in env
            ["gh", "api", "--method", "POST", f"repos/{DISPATCH_REPO}/dispatches", "--input", "-"],
            input=body, text=True, capture_output=True, env=env, timeout=60, check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        warn(f"dispatch failed: {exc.__class__.__name__}")
        return False
    if proc.returncode != 0:
        warn(f"dispatch failed: gh exited {proc.returncode}")
        return False
    return True


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--result", required=True, help="the tick's `claude -p --output-format json` stdout")
    parser.add_argument("--config", default=os.environ.get("PR_STEWARD_CONFIG") or DEFAULT_CONFIG)
    parser.add_argument("--log-offset", type=int, default=0, help="steward log size before the tick")
    parser.add_argument("--token-file", default=os.environ.get("GH_APP_TOKEN_FILE", "/run/steward/gh-token"))
    parser.add_argument("--out", help="also write {\"records\": [...]} here")
    parser.add_argument("--no-dispatch", action="store_true")
    args = parser.parse_args(argv)
    try:
        with open(args.result, encoding="utf-8") as fh:
            result = result_entry(fh.read())
    except OSError:
        result = None
    if result is None:
        warn("tick left no readable result entry; its model usage was NOT measured")
        return 0
    repos, log_path = configured(args.config)
    target = acted_pr(log_tail(log_path, args.log_offset), repos)
    captured_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    records = build_records(result, target, captured_at)
    if not records:
        warn("result entry has no model usage; its spend was NOT measured")
        return 0
    if args.out:
        with open(args.out, "w", encoding="utf-8") as fh:
            json.dump({"records": records}, fh)
    if not args.no_dispatch and dispatch(records, args.token_file):
        print(f"[pr-steward-usage] sent {len(records)} usage record(s)", file=sys.stderr)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # noqa: BLE001 - never fail the tick
        warn(f"unexpected {exc.__class__.__name__}; usage not sent")
        sys.exit(0)
