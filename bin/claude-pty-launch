#!/usr/bin/env python3
"""Run Claude Code under a PTY and answer its startup confirmations by content.

Replaces `script -qfc` for the remote-control session when a development channel
is loaded. `--dangerously-load-development-channels` shows a confirmation on
every launch and nothing persists the answer; an unattended container has no
one at the terminal, so the session would park at the dialog forever.

The driver recognises a dialog by its text -- never by timing -- with all
whitespace removed, because the TUI positions words with cursor movement and the
captured output carries no reliable spaces. Only dialogs listed here are
answered, and only with the option this deployment already chose on its command
line (it passed the development-channels flag and --dangerously-skip-permissions).
Anything else is left alone.

Output is copied to stdout so the container log keeps the session transcript, as
`script ... /dev/stdout` did. SIGTERM/SIGINT are forwarded; the exit status is the
child's.

Usage: claude-pty-launch -- claude --remote-control NAME ...
"""

from __future__ import annotations

import errno
import os
import pty
import re
import select
import signal
import sys
import time

ANSI = re.compile(rb"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07]*(\x07|\x1b\\)|\x1b[()][A-Z0-9]|\r")
DOWN, ENTER = b"\x1b[B", b"\r"

# (label, whitespace-free text that identifies the dialog, keys that accept it)
DIALOGS = (
    ("development-channels", rb"Iamusingthisforlocaldevelopment", ENTER),
    ("trust-folder", rb"Yes,Itrustthisfolder", DOWN + ENTER),
    ("bypass-permissions", rb"Yes,Iaccept", DOWN + ENTER),
)
WINDOW = 16000


def log(message: str) -> None:
    sys.stderr.write(f"[claude-pty-launch] {message}\n")
    sys.stderr.flush()


def answer_for(screen: bytes, answered: dict[str, int]) -> tuple[str, bytes] | None:
    """Return the dialog to answer if a new occurrence is on screen."""

    flat = re.sub(rb"\s+", b"", ANSI.sub(b"", screen))
    for label, pattern, keys in DIALOGS:
        hits = flat.count(pattern)
        if hits > answered.get(label, 0):
            answered[label] = hits
            return label, keys
    return None


def main(argv: list[str]) -> int:
    if argv[:1] == ["--"]:
        argv = argv[1:]
    if not argv:
        log("usage: claude-pty-launch -- <command> [args...]")
        return 2
    settle = float(os.environ.get("CLAUDE_PTY_ANSWER_DELAY_SECONDS", "1.0"))

    pid, fd = pty.fork()
    if pid == 0:
        os.environ.setdefault("TERM", "xterm-256color")
        try:
            os.execvp(argv[0], argv)
        except OSError as exc:
            sys.stderr.write(f"exec {argv[0]}: {exc}\n")
            os._exit(127)

    def forward(signum, _frame):
        try:
            os.kill(pid, signum)
        except ProcessLookupError:
            pass

    signal.signal(signal.SIGTERM, forward)
    signal.signal(signal.SIGINT, forward)

    screen = b""
    answered: dict[str, int] = {}
    out = sys.stdout.buffer
    while True:
        try:
            ready, _, _ = select.select([fd], [], [], 0.5)
        except InterruptedError:
            continue
        if ready:
            try:
                chunk = os.read(fd, 65536)
            except OSError as exc:
                if exc.errno == errno.EIO:  # child closed the PTY
                    break
                raise
            if not chunk:
                break
            out.write(chunk)
            out.flush()
            # Keep a window across chunk boundaries: a dialog can be drawn in pieces.
            screen = (screen + chunk)[-WINDOW:]
            found = answer_for(screen, answered)
            if found:
                label, keys = found
                time.sleep(settle)  # let the dialog finish drawing before keys arrive
                os.write(fd, keys)
                log(f"answered {label}")
                screen = b""
        else:
            done, status = os.waitpid(pid, os.WNOHANG)
            if done:
                return os.waitstatus_to_exitcode(status)
    _, status = os.waitpid(pid, 0)
    return os.waitstatus_to_exitcode(status)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
