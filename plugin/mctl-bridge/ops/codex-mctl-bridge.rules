# Installed by ops/install.sh as ~/.codex/rules/mctl-bridge.rules on the Mac mini.
# Lets the orchestrator thread run the bridge CLI without an approval prompt, so a
# wake can be answered while every client (laptop, phone) is closed. Only the
# subcommands an orchestrator needs are allowed. `resolve`, `init` and `sweep` still
# prompt: those are operator decisions.
prefix_rule(
    pattern = ["mctl-bridge", ["sessions", "tasks", "status", "errors", "wakes", "claim", "renew", "reply", "steer", "send", "wait"]],
    decision = "allow",
    justification = "mctl-bridge orchestrator CLI: local Valkey as bridge_orch, no other access",
    match = [["mctl-bridge", "status", "q-1"], ["mctl-bridge", "reply", "q-1", "--token", "c-1", "--text", "yes"], ["mctl-bridge", "reply", "q-1", "--token", "c-1", "--file", "/w/answer.txt"], ["mctl-bridge", "reply", "q-1", "--token", "c-1", "--stdin"], ["mctl-bridge", "steer", "t-1", "--file", "/w/note.txt"]],
    not_match = [["mctl-bridge", "resolve", "t-1", "--as", "failed", "--reason", "x"], ["mctl-bridge", "init"], ["mctl-bridge-x", "status"]],
)

# The orchestrator's GitHub writes, as the mctl-codex App. There is no approve command, the
# merge checks the gate itself, and reading the App key directly still prompts.
prefix_rule(
    pattern = ["mctl-publish", ["status", "publish", "ready", "merge", "update-branch"]],
    decision = "allow",
    justification = "mctl-publish: GitHub writes as the mctl-codex App, without admin rights",
    match = [["mctl-publish", "status"], ["mctl-publish", "merge", "--repo", "r", "--pr", "1", "--head", "a"]],
    not_match = [["mctl-publish", "approve"], ["mctl-publish-x", "status"], ["cat", "codex-github-app.pem"]],
)
